{
  "permissions": {
    "allow": ["Bash(.venv/bin/python scripts/molecule.py:*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-before-push.sh\"",
            "timeout": 300,
            "statusMessage": "Linting before push"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-after-edit.sh\"",
            "timeout": 30,
            "statusMessage": "Linting edited file"
          }
        ]
      }
    ]
  }
}
